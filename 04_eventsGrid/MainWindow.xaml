<Window x:Class="_04_eventsGrid.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_04_eventsGrid"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="320">

    <Grid>
        <!-- Definicio de files -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Definicio de columnes-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        
        
        <!-- Pantalla -->
        <TextBox x:Name="tbTauler"
                 Grid.ColumnSpan="4"
                 Margin="10"
                 FontSize="40"
                 Text="0" TextChanged="tbTauler_TextChanged">
        </TextBox>
        
        <!-- Botons -->
        <Button x:Name="btnDelete" Grid.Row="1" Grid.Column="0" Content="DELETE"></Button>
        <Button x:Name="btnCE" Grid.Row="1" Grid.Column="1" Content="CE" Click="btnCE_Click"></Button>
        <Button x:Name="btnC" Grid.Row="1" Grid.Column="2" Content="C" Click="btnC_Click"></Button>
        <Button x:Name="btnDiv" Grid.Row="1" Grid.Column="3" Content="/" Click="btnDiv_Click"></Button>
        <Button x:Name="btn7" Grid.Row="2" Grid.Column="0" Content="7" Click="btn7_Click"></Button>
        <Button x:Name="btn8" Grid.Row="2" Grid.Column="1" Content="8" Click="btn8_Click"></Button>
        <Button x:Name="btn9" Grid.Row="2" Grid.Column="2" Content="9" Click="btn9_Click"></Button>
        <Button x:Name="btnMulti" Grid.Row="2" Grid.Column="3" Content="X" Click="btnMulti_Click"></Button>
        <Button x:Name="btn4" Grid.Row="3" Grid.Column="0" Content="4" Click="btn4_Click"></Button>
        <Button x:Name="btn5" Grid.Row="3" Grid.Column="1" Content="5" Click="btn5_Click"></Button>
        <Button x:Name="btn6" Grid.Row="3" Grid.Column="2" Content="6" Click="btn6_Click"></Button>
        <Button x:Name="btnResta" Grid.Row="3" Grid.Column="3" Content="-" Click="btnResta_click"></Button>
        <Button x:Name="btn1" Grid.Row="4" Grid.Column="0" Content="1" Click="btn1_Click"></Button>
        <Button x:Name="btn2" Grid.Row="4" Grid.Column="1" Content="2" Click="btn2_Click"></Button>
        <Button x:Name="btn3" Grid.Row="4" Grid.Column="2" Content="3" Click="btn3_Click"></Button>
        <Button x:Name="btnSum" Grid.Row="4" Grid.Column="3" Content="+" Click="btnSum_Click"></Button>
        <Button Grid.Row="5" Grid.Column="0" Content="+/-"></Button>
        <Button x:Name="btn0" Grid.Row="5" Grid.Column="1" Content="0" Click="btn0_Click"></Button>
        <Button x:Name="btnDot" Grid.Row="5" Grid.Column="2" Content="." Click="btnDot_Click"></Button>
        <Button x:Name="btnIgual" Grid.Row="5" Grid.Column="3" Content="=" Click="btnIgual_Click"></Button>


    </Grid>
    
</Window>
